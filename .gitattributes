# The vendored SSOT-mirror JSON-Schemas are BYTE-FOR-BYTE copies of the
# molecule-ai-sdk (contracts/) originals, enforced offline/at-drift by
# scripts/check-schemas-in-sync.sh and tests/test_workspace_comms_conformance.py
# (see the PROVENANCE.md next to each). The sdk serves them LF over the raw
# endpoint, so the vendored copies MUST stay LF on every platform — pin them so
# an autocrlf=true (Windows) checkout can't smudge them to CRLF and trip the
# byte-identical gate.
molecule_runtime/contracts/*.schema.json text eol=lf
tests/fixtures/workspace_comms/*.schema.json text eol=lf
scripts/check-schemas-in-sync.sh text eol=lf

# The SAME byte-exact gate covers more than *.schema.json. The MAP in
# scripts/check-schemas-in-sync.sh fetches the molecule-ai-sdk original for each
# vendored path and runs a RAW `diff -u "$local_file" "$tmp/$slug"`. The rule
# above only reaches the five *.schema.json mirrors; these ten mapped paths are
# gated identically but were left unpinned, so a core.autocrlf=true checkout can
# still smudge them to CRLF and red the gate on newlines alone.
molecule_runtime/contracts/*.contract.json text eol=lf
molecule_runtime/contracts/*.fixtures.json text eol=lf
molecule_runtime/contracts/native-plugins.registry.json text eol=lf
contracts/mcp-plugin-delivery.contract.json text eol=lf
